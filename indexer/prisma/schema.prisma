// Read model for indexed protocol accounts.
// The indexer writes these tables from getProgramAccounts snapshots.
// Chain accounts remain the source of truth.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Node {
  id              String      @id
  authority       String
  operator        String
  vrfPubkey       String?     @map("vrf_pubkey")
  stakeLamports   BigInt      @default(0) @map("stake_lamports")
  jobMask         Int         @default(0) @map("job_mask")
  status          String
  reputation      BigInt      @default(0)
  createdSlot     BigInt      @map("created_slot")
  lastHeartbeat   BigInt?     @map("last_heartbeat")
  cooldownEndSlot BigInt?     @map("cooldown_end_slot")
  updatedSlot     BigInt      @map("updated_slot")
  events          NodeEvent[]

  @@index([authority])
  @@index([status])
  @@map("nodes")
}

model NodeEvent {
  id        String @id
  nodeId    String @map("node_id")
  node      Node   @relation(fields: [nodeId], references: [id])
  slot      BigInt
  signature String
  kind      String

  @@index([nodeId, slot])
  @@index([signature])
  @@map("node_events")
}

model Request {
  id                String         @id
  jobType           String         @map("job_type")
  status            String
  requester         String
  callback          String?
  maxFee            BigInt         @default(0) @map("max_fee")
  createdSlot       BigInt         @map("created_slot")
  expiresSlot       BigInt         @default(0) @map("expires_slot")
  assignedNode      String?        @map("assigned_node")
  assignedStake     BigInt?        @map("assigned_stake")
  assignedHeartbeat BigInt?        @map("assigned_heartbeat")
  updatedSlot       BigInt         @map("updated_slot")
  events            RequestEvent[]
  result            Result?
  verification      Verification?

  @@index([status, updatedSlot])
  @@index([jobType])
  @@index([requester])
  @@map("requests")
}

model RequestEvent {
  id        String  @id
  requestId String  @map("request_id")
  request   Request @relation(fields: [requestId], references: [id])
  slot      BigInt
  signature String
  kind      String

  @@index([requestId, slot])
  @@index([signature])
  @@map("request_events")
}

model Job {
  id           String @id
  jobType      String @unique @map("job_type")
  feeLamports  BigInt @map("fee_lamports")
  timeoutSlots BigInt @map("timeout_slots")
  quorum       Int
  updatedSlot  BigInt @map("updated_slot")

  @@map("jobs")
}

model Result {
  id         String  @id
  requestId  String  @unique @map("request_id")
  request    Request @relation(fields: [requestId], references: [id])
  slot       BigInt
  commitment String
  nodeId     String? @map("node_id")
  outputHex  String? @map("output_hex")

  @@index([slot])
  @@map("results")
}

model Verification {
  id        String  @id
  requestId String  @unique @map("request_id")
  request   Request @relation(fields: [requestId], references: [id])
  status    String
  slot      BigInt
  nodeId    String? @map("node_id")
  outputHex String? @map("output_hex")

  @@index([status])
  @@map("verifications")
}

model Challenge {
  id         String @id
  requestId  String @map("request_id")
  challenger String
  status     String
  slot       BigInt

  @@unique([requestId, challenger])
  @@index([status])
  @@map("challenges")
}

model Reward {
  id        String @id
  requestId String @map("request_id")
  recipient String
  lamports  BigInt
  slot      BigInt
  signature String

  @@index([recipient, slot])
  @@index([signature])
  @@map("rewards")
}

model ChainTransaction {
  signature String  @id
  slot      BigInt
  success   Boolean
  programId String  @map("program_id")

  @@index([slot])
  @@index([programId])
  @@map("transactions")
}

model Model {
  id       String         @id
  name     String         @unique
  versions ModelVersion[]

  @@map("models")
}

model ModelVersion {
  id          String @id
  modelId     String @map("model_id")
  model       Model  @relation(fields: [modelId], references: [id])
  digest      String
  createdSlot BigInt @map("created_slot")

  @@unique([modelId, digest])
  @@map("model_versions")
}

model PriceObservation {
  id         String   @id
  symbol     String
  source     String
  price      Decimal  @db.Decimal(38, 18)
  slot       BigInt
  observedAt DateTime @map("observed_at")

  @@index([symbol, slot])
  @@map("price_observations")
}

model NetworkMetric {
  id         String   @id
  name       String
  slot       BigInt
  value      Decimal  @db.Decimal(38, 18)
  observedAt DateTime @map("observed_at")

  @@index([name, slot])
  @@map("network_metrics")
}

model Checkpoint {
  id                      String    @id
  lastProcessedSlot       BigInt?   @map("last_processed_slot")
  lastProcessedSignature  String?   @map("last_processed_signature")
  updatedAt               DateTime  @map("updated_at")

  @@map("checkpoints")
}

model Registry {
  id                     String  @id
  authority              String
  nodeCount              BigInt  @map("node_count")
  minStake               BigInt  @map("min_stake")
  unstakeCooldownSlots   BigInt  @map("unstake_cooldown_slots")
  heartbeatTimeoutSlots  BigInt  @map("heartbeat_timeout_slots")
  slashAuthority         String? @map("slash_authority")
  slashDestination       String? @map("slash_destination")
  updatedSlot            BigInt  @map("updated_slot")

  @@map("registry")
}

model Protocol {
  id          String  @id
  authority   String
  paused      Boolean
  updatedSlot BigInt  @map("updated_slot")

  @@map("protocol")
}
